#:import dp kivy.metrics.dp


<SpectralFlowScreen>:
    name: "spectral_flow"
    x_field:           x_in
    y_field:           y_in
    steps_field:       steps_in
    output_label:      out
    invariant_label:   inv

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        MDTopAppBar:
            title: "Spectral flow Φ"
            left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "home")]]

        MDGridLayout:
            cols: 3
            spacing: dp(8)
            size_hint_y: None
            height: dp(56)
            MDTextField:
                id: x_in
                hint_text: "x"; text: "1.0"; mode: "rectangle"
            MDTextField:
                id: y_in
                hint_text: "y"; text: "1.0"; mode: "rectangle"
            MDTextField:
                id: steps_in
                hint_text: "steps"; text: "5"; mode: "rectangle"

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(8)
            MDRaisedButton:
                text: "Run Φⁿ"
                on_release: root.run_flow()
            MDFlatButton:
                text: "Find fixed point"
                on_release: root.find_fixed_point()

        MDLabel:
            id: inv
            text: ""
            theme_text_color: "Hint"
            size_hint_y: None
            height: dp(28)

        ScrollView:
            MDLabel:
                id: out
                text: ""
                font_style: "Body2"
                font_name: "RobotoMono-Regular"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: "left"

        MDLabel:
            text: root.status
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(24)
