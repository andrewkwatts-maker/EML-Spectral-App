#:import dp kivy.metrics.dp


<SpacetimeScreen>:
    name: "spacetime"
    x_field:        x_in
    y_field:        y_in
    rapidity_field: phi_in
    output_label:   out

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        MDTopAppBar:
            title: "Spacetime"
            left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "home")]]

        MDGridLayout:
            cols: 3
            spacing: dp(8)
            size_hint_y: None
            height: dp(56)
            MDTextField:
                id: x_in
                hint_text: "x"; text: "1.0"; mode: "rectangle"
            MDTextField:
                id: y_in
                hint_text: "y"; text: "2.718"; mode: "rectangle"
            MDTextField:
                id: phi_in
                hint_text: "rapidity φ"; text: "0.5"; mode: "rectangle"

        MDRaisedButton:
            text: "Compute"
            on_release: root.compute()
            size_hint_x: None
            width: dp(140)

        ScrollView:
            MDLabel:
                id: out
                text: ""
                font_style: "Body2"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: "left"

        MDLabel:
            text: root.status
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(24)
